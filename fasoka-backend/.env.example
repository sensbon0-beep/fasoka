# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/fasoka
PGHOST=localhost
PGPORT=5432
PGDATABASE=fasoka
PGUSER=postgres
PGPASSWORD=changeme

# Serveur
PORT=4000
NODE_ENV=development

# Sécurité
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Mobile Money (à remplir une fois le partenariat obtenu)
MIXX_API_KEY=
MIXX_API_SECRET=
MIXX_BASE_URL=
FLOOZ_API_KEY=
FLOOZ_API_SECRET=
FLOOZ_BASE_URL=

# Mode simulation paiement (true tant que les vraies clés API ne sont pas actives)
PAYMENT_SIMULATION_MODE=true

# Stockage des images (Cloudinary - compte gratuit sur cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
